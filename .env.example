# Stripe keys for the onboarding checkout. Use sandbox (test) keys until the
# live-mode prices in src/lib/site.ts are swapped in.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Supabase Auth for client accounts (log in, sign up, password reset).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Cal.com API key for the /book page (optional for a public event type; server-only).
CAL_API_KEY=cal_live_...

# Resend API key (server-only) so client messages, setup changes, plan changes and
# new-client onboarding answers are emailed to the team. Same key as the Supabase SMTP password works.
RESEND_API_KEY=re_...
# Optional overrides
# TEAM_EMAIL=contact@praz.ai
# NOTIFY_FROM=Praz <no-reply@praz.ai>
